# Copy this file to .env and fill in the required values.

# Release 3 controlled agent (optional; rules-only mode works without a key)
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_ROLE_MAP_JSON=
AGENT_MODEL=gemini-3.6-flash
# Legacy draft-generation experiment; this does not power the controlled agent.
ANTHROPIC_API_KEY=

# Paths (adjust to match your local installation)
AFIS_DB_PATH=../AFIS/afis_finance.db
AXIS_DB_PATH=../AXIS/axis_tax.db

# OCR (Tesseract)
# TESSERACT_CMD=/usr/bin/tesseract    # Linux/Mac
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe   # Windows
TESSERACT_CMD=tesseract

# Collection email (optional; dry run is enabled by default)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_DRY_RUN=true    # Set to false only when ready to send real emails.

# Company details used in collection drafts
# Configure through the dashboard or here.
# COMPANY_NAME=
# COMPANY_EMAIL=

# Reconciliation thresholds
AUTO_APPROVE_THRESHOLD=0.90  # confidence at or above 0.90 permits automatic approval
HUMAN_REVIEW_THRESHOLD=0.60  # confidence below 0.60 requires manual review

# Collection stages in days after the due date
DUNNING_STAGE1_DAYS=7
DUNNING_STAGE2_DAYS=15
DUNNING_STAGE3_DAYS=30
DUNNING_STAGE4_DAYS=45
CONTACT_COOLDOWN_DAYS=7

# Forecast
DSO_TARGET_DAYS=30            # target DSO in days
DSO_FORECAST_HORIZON=90       # forecast horizon in days

# Server
HOST=127.0.0.1
PORT=8002
DEBUG=false
RECOVERFLOW_API_KEY=replace-with-a-long-random-secret
# Optional multi-user mapping: [{"key":"...","actor":"alice","tenant_id":"company-a","role":"admin"}]
RECOVERFLOW_API_KEYS_JSON=
MAX_UPLOAD_BYTES=10485760

# Release 2 India pilot. Leave blank until each provider account is ready.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_GRAPH_API_VERSION=


